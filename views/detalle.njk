{% extends "base.njk" %}

{% block title %}{{ card.titulo }} - Tienda Prado{% endblock %}

{% block extra_css %}
<style>
  .detail-img {
    max-height: 500px;
    object-fit: contain;
    background: var(--prado-light);
    padding: 20px;
    width: 100%;
  }
  .detail-title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 1.5rem;
    font-weight: normal;
    line-height: 1.4;
  }
  .detail-price {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 15px 0 20px;
  }
  .detail-desc {
    color: var(--prado-gray);
    font-size: 0.92rem;
    line-height: 1.7;
    white-space: pre-line;
  }
  .add-cart-form {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid var(--prado-border);
  }
  .added-msg {
    background: #d4edda;
    color: #155724;
    padding: 10px 15px;
    font-size: 0.85rem;
    margin-top: 15px;
  }
</style>
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
    <li class="breadcrumb-item"><a href="/">IMPRESIONES</a></li>
    <li class="breadcrumb-item active">{{ card.titulo }}</li>
  </ol>
</nav>

<div class="row g-5">
  <div class="col-md-5">
    <img src="/public/imagenes/{{ card.imagen }}"
         class="detail-img"
         alt="{{ card.titulo }}"
         onerror="this.src='https://placehold.co/500x400?text=Sin+imagen'">
  </div>
  <div class="col-md-7">
    <h1 class="detail-title">{{ card.titulo }}</h1>
    <p class="detail-desc">{{ card.descripcion }}</p>
    <p class="detail-price">{{ card.precio | precio }} &euro;</p>

    <!-- Formulario de compra -->
    <form action="/al-carrito/{{ card.id }}" method="POST" class="add-cart-form">
      <input type="number" value="1" min="1" name="cantidad" class="form-control qty-input">
      <button class="btn btn-prado" type="submit">
        Añadir a la cesta
      </button>
    </form>

    {% if added %}
    <div class="added-msg">
      <i class="bi bi-check-circle"></i> Producto añadido al carrito
    </div>
    {% endif %}

    <a href="/" class="btn btn-prado-outline mt-4">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
  </div>
</div>
{% endblock %}
