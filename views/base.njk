<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Tienda Prado{% endblock %}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --prado-dark: #1a1a1a;
      --prado-gray: #6c6c6c;
      --prado-light: #f5f5f5;
      --prado-border: #e0e0e0;
    }

    /* Sticky footer layout */
    html, body { height: 100%; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background-color: #fff;
      color: var(--prado-dark);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    .page-wrap { flex: 1 0 auto; }
    .footer-prado { flex-shrink: 0; }

    /* Top bar */
    .top-bar {
      background-color: #fff;
      border-bottom: 1px solid var(--prado-border);
      padding: 8px 0;
      font-size: 0.8rem;
      color: var(--prado-gray);
    }

    /* Brand */
    .brand-section {
      text-align: center;
      padding: 20px 0 15px;
      border-bottom: 1px solid var(--prado-border);
    }
    .brand-name {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 1.8rem;
      letter-spacing: 6px;
      color: var(--prado-dark);
      text-decoration: none;
      font-weight: normal;
      text-transform: uppercase;
    }
    .brand-name:hover { color: var(--prado-dark); text-decoration: none; }

    /* Icons bar */
    .icons-bar {
      position: absolute;
      right: 30px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      gap: 18px;
      align-items: center;
    }
    .icon-link {
      color: var(--prado-dark);
      font-size: 1.2rem;
      text-decoration: none;
      position: relative;
      transition: color 0.2s;
    }
    .icon-link:hover { color: var(--prado-gray); }
    .cart-count {
      position: absolute;
      top: -8px;
      right: -10px;
      background: var(--prado-dark);
      color: #fff;
      font-size: 0.6rem;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Nav */
    .nav-prado {
      border-bottom: 1px solid var(--prado-border);
      padding: 12px 0;
      display: flex;
      justify-content: center;
      gap: 30px;
      flex-wrap: wrap;
    }
    .nav-prado a {
      color: var(--prado-dark);
      text-decoration: none;
      font-size: 0.78rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-prado a:hover, .nav-prado a.active { color: var(--prado-gray); }

    /* Content */
    .main-content { padding: 30px 0 60px; }

    /* Cards */
    .product-card {
      border: none;
      border-radius: 0;
      transition: box-shadow 0.3s, transform 0.2s;
      cursor: pointer;
      background: #fff;
    }
    .product-card:hover {
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      transform: translateY(-3px);
    }
    .product-card .card-img-top {
      height: 260px;
      object-fit: contain;
      padding: 15px;
      background: var(--prado-light);
    }
    .product-card .card-body { text-align: center; padding: 15px 10px; }
    .product-card .card-title {
      font-size: 0.85rem;
      color: var(--prado-dark);
      margin-bottom: 8px;
      line-height: 1.4;
      min-height: 40px;
    }
    .product-card .card-price {
      font-size: 0.9rem;
      color: var(--prado-dark);
      font-weight: 500;
    }

    /* Buttons */
    .btn-prado {
      background-color: var(--prado-dark);
      color: #fff;
      border: none;
      border-radius: 0;
      padding: 10px 30px;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: background-color 0.3s;
    }
    .btn-prado:hover { background-color: #333; color: #fff; }
    .btn-prado-outline {
      background: transparent;
      color: var(--prado-dark);
      border: 1px solid var(--prado-dark);
      border-radius: 0;
      padding: 10px 30px;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.3s;
    }
    .btn-prado-outline:hover { background-color: var(--prado-dark); color: #fff; }
    .btn-prado-danger {
      background-color: #dc3545;
      color: #fff;
      border: none;
      border-radius: 0;
      padding: 10px 30px;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: background-color 0.3s;
    }
    .btn-prado-danger:hover { background-color: #b02a37; color: #fff; }

    /* Search */
    .search-input {
      border: 1px solid var(--prado-border);
      border-radius: 0;
      padding: 10px 15px;
      font-size: 0.9rem;
    }
    .search-input:focus { box-shadow: none; border-color: var(--prado-dark); }

    /* Form inputs (general) */
    .prado-input {
      border: 1px solid var(--prado-border);
      border-radius: 0;
      padding: 12px 15px;
      font-size: 0.9rem;
    }
    .prado-input:focus { box-shadow: none; border-color: var(--prado-dark); }

    /* Breadcrumb */
    .breadcrumb { font-size: 0.85rem; }
    .breadcrumb a { color: var(--prado-gray); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    /* Section heading */
    .section-title {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 1.6rem;
      font-weight: normal;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 4px;
      margin-bottom: 10px;
    }
    .product-count {
      text-align: center;
      font-size: 0.85rem;
      color: var(--prado-gray);
      margin-bottom: 25px;
    }

    /* Footer */
    .footer-prado {
      background-color: var(--prado-dark);
      color: #fff;
      padding: 30px 0;
      text-align: center;
      font-size: 0.8rem;
      letter-spacing: 1px;
      margin-top: auto;
    }

    /* Quantity input */
    .qty-input {
      width: 60px;
      text-align: center;
      border: 1px solid var(--prado-border);
      border-radius: 0;
      padding: 8px;
    }
    .qty-input:focus { box-shadow: none; border-color: var(--prado-dark); }

    /* Qty controls in cart */
    .qty-controls {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .qty-btn {
      width: 32px;
      height: 32px;
      border: 1px solid var(--prado-border);
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.9rem;
      transition: background-color 0.2s;
      padding: 0;
    }
    .qty-btn:hover { background: var(--prado-light); }
    .qty-display {
      width: 40px;
      height: 32px;
      border-top: 1px solid var(--prado-border);
      border-bottom: 1px solid var(--prado-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
    }

    /* Alert messages */
    .alert-prado {
      padding: 12px 15px;
      font-size: 0.85rem;
      border-radius: 0;
      margin-bottom: 20px;
    }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-error { background: #f8d7da; color: #842029; }
    .alert-info { background: #d1ecf1; color: #0c5460; }
  </style>
  {% block extra_css %}{% endblock %}
</head>
<body>

  <div class="page-wrap">
    <!-- Top bar -->
    <div class="top-bar">
      <div class="container d-flex justify-content-between align-items-center">
        <span>MUSEO DEL PRADO</span>
        <span>ES</span>
      </div>
    </div>

    <!-- Brand + icons -->
    <div class="brand-section position-relative">
      <a href="/" class="brand-name">Tienda Prado</a>
      <div class="icons-bar">
        <a href="javascript:void(0)" class="icon-link" onclick="document.getElementById('search-bar').classList.toggle('d-none')">
          <i class="bi bi-search"></i>
        </a>
        {% if usuario %}
          <a href="/perfil" class="icon-link">
            <i class="bi bi-person-fill"></i>
          </a>
          <a href="/logout" class="icon-link">
            <i class="bi bi-box-arrow-right"></i>
          </a>
        {% else %}
          <a href="/login" class="icon-link">
            <i class="bi bi-person"></i>
          </a>
        {% endif %}
        <a href="/carrito" class="icon-link">
          <i class="bi bi-bag"></i>
          {% if total_carrito %}
            <span class="cart-count">{{ total_carrito }}</span>
          {% endif %}
        </a>
      </div>
    </div>

    <!-- Search bar (hidden by default) -->
    <div id="search-bar" class="d-none border-bottom py-3">
      <div class="container">
        <form action="/buscar" method="GET" class="d-flex gap-2">
          <input type="text" name="busqueda" class="form-control search-input" placeholder="Buscar productos..." value="{{ busqueda }}" autofocus>
          <button class="btn btn-prado" type="submit"><i class="bi bi-search"></i></button>
        </form>
      </div>
    </div>

    <!-- Navigation -->
    <div class="nav-prado">
      <a href="/" class="active">Impresiones</a>
      {% if admin %}
        <a href="/admin">Admin</a>
      {% endif %}
    </div>

    <!-- Main content -->
    <div class="container main-content">
      {% block content %}{% endblock %}
    </div>
  </div>

  <!-- Footer (always at bottom) -->
  <footer class="footer-prado">
    <p class="mb-0">SSBW &mdash; Tienda Prado &mdash; Sistemas Software Basados en Web</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  {% block extra_js %}{% endblock %}
</body>
</html>
