{% extends "base.njk" %}

{% block title %}Cesta - Tienda Prado{% endblock %}

{% block extra_css %}
<style>
  .cart-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--prado-border);
  }
  .cart-item-img {
    width: 90px;
    height: 90px;
    object-fit: contain;
    background: var(--prado-light);
    padding: 5px;
    flex-shrink: 0;
  }
  .cart-item-info { flex: 1; }
  .cart-item-title { font-size: 0.9rem; margin-bottom: 4px; }
  .cart-item-unit { font-size: 0.8rem; color: var(--prado-gray); }
  .cart-summary {
    background: var(--prado-light);
    padding: 25px;
    margin-top: 20px;
  }
  .cart-total { font-size: 1.2rem; font-weight: 600; }
  .empty-cart {
    text-align: center;
    padding: 80px 0;
    color: var(--prado-gray);
  }
  .empty-cart i { font-size: 3.5rem; margin-bottom: 20px; display: block; opacity: 0.5; }
</style>
{% endblock %}

{% block content %}
<h1 class="section-title">Cesta</h1>

{% if items and items.length > 0 %}
  <div class="row g-4">
    <div class="col-lg-8">
      {% for item in items %}
      <div class="cart-item">
        <a href="/producto/{{ item.id }}">
          <img src="/public/imagenes/{{ item.imagen }}" class="cart-item-img" alt="{{ item.titulo }}"
               onerror="this.src='https://placehold.co/90x90?text=img'">
        </a>
        <div class="cart-item-info">
          <a href="/producto/{{ item.id }}" class="text-decoration-none text-dark">
            <p class="cart-item-title fw-medium">{{ item.titulo }}</p>
          </a>
          <p class="cart-item-unit">{{ item.precio | precio }} &euro; / unidad</p>

          <!-- Quantity controls -->
          <div class="d-flex align-items-center gap-3 mt-2">
            <div class="qty-controls">
              <form action="/actualizar-carrito/{{ item.id }}" method="POST" class="d-inline">
                <input type="hidden" name="cantidad" value="{{ item.cantidad - 1 }}">
                <button type="submit" class="qty-btn" {% if item.cantidad <= 1 %}disabled{% endif %}>
                  <i class="bi bi-dash"></i>
                </button>
              </form>
              <span class="qty-display">{{ item.cantidad }}</span>
              <form action="/actualizar-carrito/{{ item.id }}" method="POST" class="d-inline">
                <input type="hidden" name="cantidad" value="{{ item.cantidad + 1 }}">
                <button type="submit" class="qty-btn">
                  <i class="bi bi-plus"></i>
                </button>
              </form>
            </div>
            <form action="/quitar-del-carrito/{{ item.id }}" method="POST" class="d-inline">
              <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                <i class="bi bi-trash"></i> Eliminar
              </button>
            </form>
          </div>
        </div>
        <div class="text-end">
          <p class="fw-semibold mb-0">{{ item.subtotal | precio }} &euro;</p>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="col-lg-4">
      <div class="cart-summary">
        <h5 class="mb-3" style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px;">Resumen del pedido</h5>
        <div class="d-flex justify-content-between mb-2">
          <span>{{ total_carrito }} artículo(s)</span>
          <span>{{ total_precio | precio }} &euro;</span>
        </div>
        <hr>
        <div class="d-flex justify-content-between cart-total mb-4">
          <span>Total</span>
          <span>{{ total_precio | precio }} &euro;</span>
        </div>
        <a href="/checkout" class="btn btn-prado w-100">Finalizar pedido</a>
        <a href="/" class="btn btn-prado-outline w-100 mt-2">Seguir comprando</a>
      </div>
    </div>
  </div>
{% else %}
  <div class="empty-cart">
    <i class="bi bi-bag"></i>
    <h4 style="font-weight: normal; margin-bottom: 10px;">Tu cesta está vacía</h4>
    <p>Añade productos para comenzar</p>
    <a href="/" class="btn btn-prado mt-3">Ver productos</a>
  </div>
{% endif %}
{% endblock %}
