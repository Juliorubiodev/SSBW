---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Tienda Prado - Astro' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-200 font-montserrat">
    <!-- Navegación -->
    <nav class="navbar bg-base-100 shadow-sm justify-center gap-2 px-4">
      <a href="/" class="btn btn-ghost text-lg font-garamond">Portada</a>
      <a href="/carrousel" class="btn btn-ghost text-lg font-garamond">Carrousel</a>
      <a href="/ssg" class="btn btn-ghost text-lg font-garamond">SSG</a>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="footer footer-center p-4 bg-base-300 text-base-content mt-auto">
      <p>SSBW — Tienda Prado — Astro + React Islands</p>
    </footer>
  </body>
</html>
