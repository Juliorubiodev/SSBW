# Variables para el despliegue de producción (docker-compose-prod.yml).
# Copia este archivo a ".env" en el VPS y pon valores seguros reales.
#
#   cp .env.prod.example .env

# PostgreSQL
POSTGRES_USER=yo
POSTGRES_PASSWORD=una_clave_muy_segura_123
POSTGRES_DB=ssbw

# JWT — usa una clave larga y aleatoria en producción
SECRET_KEY=clave_supersegura_12345

# NOTA: DATABASE_URL NO se define aquí; lo construye docker-compose-prod.yml
# automáticamente apuntando al servicio "db".
